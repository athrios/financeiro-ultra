# URL e chave publicável do projeto Supabase (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service role). Usada apenas por scripts de desenvolvimento
# (npm run seed:dev). Nunca usar no código da aplicação nem expor ao navegador.
SUPABASE_SECRET_KEY=

# Senha dos usuarios de desenvolvimento do seed:dev (opcional; so Supabase local).
DEV_SEED_PASSWORD=
